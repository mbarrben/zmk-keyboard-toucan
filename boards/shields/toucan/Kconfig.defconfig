if SHIELD_TOUCAN_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Toucan"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Set this to the number of peripherals your dongle will have.
# Left + right Toucan halves + the BT60 = 3.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 3

# Set this to ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + your desired number of BT profiles.
# 3 peripherals + 4 host profiles: an 8th connection doesn't fit in the dongle's RAM
# alongside the 107-position Toucan + BT60 keymap.
config BT_MAX_CONN
    default 7

# Set this to the same number as BT_MAX_CONN
config BT_MAX_PAIRED
    default 7

endif

if SHIELD_TOUCAN_LEFT

config ZMK_KEYBOARD_NAME
    default "Toucan"

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default n

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default n

endif


if SHIELD_TOUCAN_DONGLE || SHIELD_TOUCAN_RIGHT
    config ZMK_POINTING
        default y
endif

if SHIELD_TOUCAN_LEFT

# Only the left half still needs SPI (nice_view). The right half's Cirque used SPI0;
# the Toucan 2 TPS43 uses I2C0, which is the same nRF52840 peripheral instance.
config SPI
    default y

endif

if SHIELD_TOUCAN_RIGHT

config I2C
    default y

endif

if SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_RIGHT

config ZMK_SPLIT
    default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 40

endif
