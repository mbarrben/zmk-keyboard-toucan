#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/input/input-event-codes.h>
// keys.h defines a 1-arg RC() (right-control) that shadows matrix_transform.h's
// RC(row, col) -- matrix_transform.h MUST stay last so the map below still expands.
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "toucan-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

    col-gpios
    = <&gpio0 9 GPIO_ACTIVE_HIGH>
    , <&gpio0 4 GPIO_ACTIVE_HIGH>
    , <&gpio0 10 GPIO_ACTIVE_HIGH>
    , <&gpio0 5 GPIO_ACTIVE_HIGH>
    , <&gpio1 11 GPIO_ACTIVE_HIGH>
    , <&gpio1 12 GPIO_ACTIVE_HIGH>
    ;
    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    };


    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
        // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
        // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
        //                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
                map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/ {
    // Behaviour-invoking processors for the TPS43's gesture events. The macOS variants are
    // the base set; the _win variants are selected at runtime by the `win_mode` listener
    // override below (see the WIN layer in config/toucan.keymap).
    input_processors {
        // The TPS43 reports INPUT_BTN_TOUCH as a LEVEL signal -- 1 while any finger is
        // down, 0 when all lift (tps43.c, `is_touching = (num_fingers > 0)`). The input
        // listener maps INPUT_BTN_TOUCH straight onto mouse button 0 (input_listener.c,
        // handle_key_code), so if it ever reaches the HID path the left button is held for
        // the whole duration of every touch -- i.e. moving the pointer drag-selects.
        //
        // is_touching_processor consumes it by returning ZMK_INPUT_PROC_STOP, but that is
        // NOT enough on its own: in filter_with_input_config, a layer override discards
        // apply_config's return value and returns 0 (CONTINUE), so STOP raised inside the
        // `scroller` or `win_mode` children is silently lost and the event leaks through.
        //
        // Relabelling the code instead mutates the event itself, which survives regardless
        // of what happens to the return value. INPUT_BTN_5 is not one of the codes
        // handle_key_code acts on (BTN_0..BTN_4 and BTN_TOUCH), so it is inert.
        // This must be the FIRST processor in every list on trackpad_listener.
        btn_touch_relabel: btn_touch_relabel {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_TOUCH INPUT_BTN_5>;
        };

        // Pinch-to-zoom. The driver reports the zoom delta as INPUT_REL_MISC.
        zip_zoom_mapper: zip_zoom_mapper {
            compatible = "zmk,input-processor-zoom";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_MISC>;
            sensitivity = <10>;
            bindings = <&kp LG(MINUS)>, <&kp LG(EQUAL)>;
            track-remainders;
        };

        zip_zoom_mapper_win: zip_zoom_mapper_win {
            compatible = "zmk,input-processor-zoom";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_MISC>;
            sensitivity = <10>;
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
            track-remainders;
        };

        // Hold the mouse layer for as long as a finger rests on the pad, so the thumb
        // keys become mouse buttons without reaching for a layer key.
        is_touching_processor: is_touching_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_5>;   // BTN_TOUCH, relabelled by btn_touch_relabel above
            bindings = <&mo 4>;
        };

        // Three-finger swipes -> desktop/space switching. Requires `three-finger-swipe;`
        // on the trackpad node -- NOT `swipes`, which is the single-finger gesture
        // (see toucan_right.overlay).
        swipe_button_mapper: swipe_button_mapper {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_NORTH INPUT_BTN_EAST INPUT_BTN_SOUTH INPUT_BTN_WEST>;
            bindings = <&kp LC(LG(UP))>, <&kp LC(LG(RIGHT))>, <&kp LC(LG(DOWN))>, <&kp LC(LG(LEFT))>;
        };

        swipe_button_mapper_win: swipe_button_mapper_win {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_NORTH INPUT_BTN_EAST INPUT_BTN_SOUTH INPUT_BTN_WEST>;
            bindings = <&kp LG(TAB)>, <&kp LG(RIGHT)>, <&kp LG(D)>, <&kp LG(LEFT)>;
        };
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    // Enabled only on the dongle (the split central) -- see toucan_dongle.overlay.
    //
    // Child order matters: zmk_input_listener scans the overrides in devicetree order and
    // the first one whose layer is active wins (process-next is not set), so `scroller`
    // must come before `win_mode` for a held LOWER/RAISE to beat a toggled-on WIN layer.
    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
        // Pointer speed is tuned on the sensor itself (`sensitivity`), so the scaler is 1:1.
        input-processors = <&btn_touch_relabel>, <&zip_xy_scaler 100 100>,
                           <&zip_scroll_scaler 1 20>, <&zip_zoom_mapper>,
                           <&is_touching_processor>, <&swipe_button_mapper>;

        // Hold LOWER/RAISE to turn the whole pad into a scroll surface (one finger).
        // Two-finger scroll from the sensor works on every layer regardless.
        scroller {
            layers = <1 2>;
            // is_touching_processor is repeated here so a touch that starts in one mode
            // and ends in another still gets its &mo 4 release -- otherwise the MOU layer
            // sticks on.
            input-processors = <
                &btn_touch_relabel
                &is_touching_processor
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 20
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            >;
        };

        // WIN layer toggled on (&tog WIN in ADJ): swap the macOS zoom/swipe shortcuts for
        // the Windows/Linux ones. Everything else is identical to the base list.
        win_mode {
            layers = <5>;
            input-processors = <&btn_touch_relabel>, <&zip_xy_scaler 100 100>,
                               <&zip_scroll_scaler 1 20>, <&zip_zoom_mapper_win>,
                               <&is_touching_processor>, <&swipe_button_mapper_win>;
        };
    };
};
